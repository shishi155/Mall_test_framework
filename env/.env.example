# ===== mall 测试环境变量模板 =====
# 用法：复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）
# 说明：以下均为本地 Docker 演示环境的测试口令，不是生产凭据。

# MySQL（宿主机 3306 被占用，映射到 13306）
MYSQL_ROOT_PASSWORD=Root@123456
MYSQL_PORT=13306

# Redis
REDIS_PASSWORD=mall123
REDIS_PORT=6379

# MongoDB
MONGO_PORT=27017

# RabbitMQ
RABBITMQ_USER=mall
RABBITMQ_PASSWORD=mall123
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Elasticsearch
ES_PORT=9200

# 被测服务与前端（admin 的 8080 被其他项目占用，映射到 18080）
ADMIN_PORT=18080
PORTAL_PORT=8085
SEARCH_PORT=18081
WEB_PORT=8090

# 可选：MinIO（--profile tools 时才启动）
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
